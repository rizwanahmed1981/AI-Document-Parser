{
  "name": "document-parser",
  "version": "1.0.0",
  "description": "Document parsing system that extracts structured data from various document formats",
  "main": "index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.{ts,js,json}"
  },
  "keywords": [
    "document",
    "parsing",
    "ai",
    "ocr"
  ],
  "author": "Document Parser Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.6.0",
    "passport-oauth2": "^1.7.0",
    "helmet": "^7.0.0",
    "bcrypt": "^5.1.0",
    "express-rate-limit": "^6.7.0",
    "pg": "^8.11.0",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/multer": "^1.4.7",
    "@types/passport": "^1.0.12",
    "@types/passport-oauth2": "^1.4.11",
    "@types/helmet": "^4.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/express-rate-limit": "^6.0.0",
    "@types/pg": "^8.10.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "nodemon": "^3.0.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  }
}